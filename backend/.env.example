PORT=5001
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
# Comma-separated list of allowed frontend origins (required in production; localhost is auto-allowed in development)
FRONTEND_ORIGINS=http://localhost:3000

# --- Two-factor authentication (authenticator app / TOTP) ---
# Name shown inside the authenticator app
TWO_FACTOR_ISSUER=Scrizians
# Encrypts the stored 2FA secrets. Use a long random string and do not change it
# afterwards (if empty, JWT_SECRET is used). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=

# --- 2FA mode: static (fixed OTP, no SMTP needed) or totp (authenticator app) ---
TWO_FACTOR_MODE=static
# 6-digit OTP used by admin/staff login while TWO_FACTOR_MODE=static. Change it!
TWO_FACTOR_STATIC_OTP=123456
